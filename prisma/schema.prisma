generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

enum StatusPacoteCliente {
  ATIVO
  FINALIZADO
  CANCELADO
}

enum EscopoBloqueio {
  TODOS
  SO_PAINEL
}

enum RecorrenciaBloqueio {
  PONTUAL
  SEMANAL
}

enum EstadoEscalonamento {
  BOT
  ESCALADO
  HUMANO_ATIVO
}

enum StatusSincronizacaoGoogleAgenda {
  PENDENTE
  SINCRONIZADO
  ERRO
}

model Cliente {
  id           String        @id @default(cuid())
  nome         String
  telefone     String        @unique
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  agendamentos Agendamento[]
  pacotes      PacoteCliente[]
  lotes        LoteAgendamento[]

  @@map("clientes")
}

model Servico {
  id                        String                  @id @default(cuid())
  nome                      String
  duracaoMinutos            Int
  preco                     Decimal?                @db.Decimal(10, 2)
  permiteExtensaoFechamento Boolean                 @default(false)
  agendamentos              Agendamento[]
  pacotes                   PacoteServico[]
  pacotesClientes           PacoteClienteServico[]
  lotes                     LoteAgendamento[]
  rascunhosAgendamento      RascunhoAgendamento[]

  @@map("servicos")
}

model Agendamento {
  id              String            @id @default(cuid())
  clienteId       String
  servicoId       String
  pacoteClienteId String?
  numeroNoPacote  Int?
  loteId          String?
  dataHoraInicio  DateTime          @db.Timestamptz(3)
  dataHoraFim     DateTime          @db.Timestamptz(3)
  status          StatusAgendamento @default(AGENDADO)
  concluido       Boolean           @default(false)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)

  cliente         Cliente           @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico         Servico           @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  pacoteCliente   PacoteCliente?    @relation(fields: [pacoteClienteId], references: [id], onDelete: Restrict)
  lote            LoteAgendamento?  @relation(fields: [loteId], references: [id], onDelete: SetNull)

  @@index([clienteId])
  @@index([servicoId])
  @@index([pacoteClienteId])
  @@index([loteId])
  @@index([dataHoraInicio, dataHoraFim, status])
  @@map("agendamentos")
}

model LoteAgendamento {
  id              String        @id @default(cuid())
  clienteId       String
  servicoId       String
  pacoteClienteId String?
  criadoEm        DateTime      @default(now()) @db.Timestamptz(3)

  cliente         Cliente       @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  servico         Servico       @relation(fields: [servicoId], references: [id], onDelete: Restrict)
  agendamentos    Agendamento[]

  @@index([clienteId])
  @@index([servicoId])
  @@map("lotes_agendamento")
}

model Pacote {
  id          String          @id @default(cuid())
  nome        String
  duracaoDias Int
  preco       Decimal         @default(0) @db.Decimal(10, 2)
  liberadoParaGemini Boolean   @default(false)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)
  servicos    PacoteServico[]
  clientes    PacoteCliente[]

  @@map("pacotes")
}

// quantidadeTotal e a quantidade "de fabrica" desse servico dentro do pacote.
model PacoteServico {
  pacoteId        String
  servicoId       String
  quantidadeTotal Int

  pacote          Pacote  @relation(fields: [pacoteId], references: [id], onDelete: Restrict)
  servico         Servico @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@id([pacoteId, servicoId])
  @@index([servicoId])
  @@map("pacotes_servicos")
}

// Regra de negocio (validar em service/controller, nao no banco):
// um Cliente so pode ter um PacoteCliente com status ATIVO por vez.
// Saldo por servico fica em PacoteClienteServico; este modelo nao guarda mais quantidade agregada.
model PacoteCliente {
  id           String                @id @default(cuid())
  clienteId    String
  pacoteId     String
  dataInicio   DateTime              @db.Timestamptz(3)
  status       StatusPacoteCliente   @default(ATIVO)
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)

  cliente      Cliente               @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  pacote       Pacote                @relation(fields: [pacoteId], references: [id], onDelete: Restrict)
  agendamentos Agendamento[]
  servicos     PacoteClienteServico[]

  @@index([clienteId])
  @@index([pacoteId])
  @@index([clienteId, status])
  @@map("pacotes_clientes")
}

// Saldo de uso por servico dentro de um PacoteCliente vendido.
model PacoteClienteServico {
  id                 String        @id @default(cuid())
  pacoteClienteId    String
  servicoId          String
  quantidadeTotal    Int
  usosAnteriores     Int           @default(0)
  quantidadeRestante Int

  pacoteCliente      PacoteCliente @relation(fields: [pacoteClienteId], references: [id], onDelete: Cascade)
  servico            Servico       @relation(fields: [servicoId], references: [id], onDelete: Restrict)

  @@unique([pacoteClienteId, servicoId])
  @@index([servicoId])
  @@map("pacotes_clientes_servicos")
}

model BloqueioHorario {
  id                  String             @id @default(cuid())
  dataHoraInicio     DateTime?          @db.Timestamptz(3)
  dataHoraFim        DateTime?          @db.Timestamptz(3)
  motivo             String
  escopo             EscopoBloqueio     @default(TODOS)
  recorrencia        RecorrenciaBloqueio @default(PONTUAL)
  diaSemana          Int?
  horaInicioMinutos  Int?
  horaFimMinutos     Int?
  createdAt           DateTime           @default(now()) @db.Timestamptz(3)

  @@index([dataHoraInicio, dataHoraFim])
  @@map("bloqueios_horario")
}

model HorarioFuncionamento {
  id                          String   @id @default(cuid())
  diaSemana                  Int      @unique
  horaAberturaMinutos        Int
  horaFechamentoMinutos      Int
  almocoInicioMinutos        Int?
  almocoFimMinutos            Int?
  limiteExtensaoMinutos      Int?
  ultimoInicioExtensaoMinutos Int?
  updatedAt                  DateTime @updatedAt

  @@map("horarios_funcionamento")
}

model ConfiguracaoAgenda {
  id            Int      @id
  horizonteDias Int?
  limiteAte     DateTime? @db.Date
  atualizadoEm  DateTime @updatedAt

  @@map("configuracoes_agenda")
}

model MensagemWhatsAppProcessada {
  provedor    String
  idMensagem  String
  registradoEm DateTime @default(now()) @db.Timestamptz(3)

  @@id([provedor, idMensagem])
  @@map("mensagens_whatsapp_processadas")
}

model EscalonamentoWhatsApp {
  telefone                String               @id
  estado                  EstadoEscalonamento  @default(BOT)
  motivo                  String?
  escaladoEm              DateTime?            @db.Timestamptz(3)
  avisoEsperaEnviadoEm    DateTime?            @db.Timestamptz(3)
  avisoMidiaEnviadoEm     DateTime?            @db.Timestamptz(3)
  humanoUltimaMensagemEm  DateTime?            @db.Timestamptz(3)
  expiraEm                DateTime?            @db.Timestamptz(3)
  atualizadoEm            DateTime             @updatedAt @db.Timestamptz(3)

  @@map("escalonamentos_whatsapp")
}

model NumeroIgnoradoWhatsApp {
  id       String   @id @default(cuid())
  telefone String   @unique
  rotulo   String
  criadoEm DateTime @default(now()) @db.Timestamptz(3)

  @@map("numeros_ignorados_whatsapp")
}

model RascunhoAgendamento {
  telefoneSessao    String   @id
  nomeCliente       String
  telefoneCliente   String
  servicoId        String
  dataHoraInicio   DateTime @db.Timestamptz(3)
  mensagemCriacaoId String
  criadoEm         DateTime @default(now()) @db.Timestamptz(3)
  expiraEm         DateTime @db.Timestamptz(3)
  lembreteEnviadoEm DateTime? @db.Timestamptz(3)
  resumoEnviadoEm  DateTime? @db.Timestamptz(3)

  servico          Servico  @relation(fields: [servicoId], references: [id], onDelete: Cascade)

  @@index([expiraEm])
  @@index([servicoId])
  @@map("rascunhos_agendamento")
}

model SincronizacaoGoogleAgenda {
  agendamentoId      String                         @id
  status             StatusSincronizacaoGoogleAgenda @default(PENDENTE)
  tentativas         Int                            @default(0)
  proximaTentativaEm DateTime                       @db.Timestamptz(3)
  ultimoErro         String?
  versao             Int                            @default(1)
  atualizadoEm       DateTime                       @updatedAt @db.Timestamptz(3)

  @@index([status, proximaTentativaEm])
  @@map("sincronizacoes_google_agenda")
}
