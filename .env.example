DATABASE_URL=
PORT=
GEMINI_API_KEY=
EVOLUTION_API_KEY=
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_INSTANCE_NAME=barbearia
# Provedor WhatsApp: evolution (padrão) ou ycloud
WHATSAPP_PROVIDER=evolution
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
# Número conectado à YCloud em formato E.164, incluindo "+"
YCLOUD_FROM_NUMBER=
# Allowlist temporária da rota YCloud: telefones separados por vírgula; vazio desativa
WHATSAPP_ALLOWLIST=
# Cooldown do aviso de mensagem não textual, em milissegundos
MEDIA_NOTICE_COOLDOWN_MS=600000
# Habilita transcrição de áudio; aceite apenas true ou false
AUDIO_TRANSCRIPTION_ENABLED=false
# Limite de áudio recebido em bytes
AUDIO_MAX_BYTES=600000
# Timeout de download de áudio em milissegundos
AUDIO_DOWNLOAD_TIMEOUT_MS=10000
# Timeout de transcrição Gemini em milissegundos
AUDIO_TRANSCRIBE_TIMEOUT_MS=30000
# Máximo de transcrições simultâneas
AUDIO_MAX_CONCURRENCY=3
# Máximo de áudios aguardando processamento
AUDIO_MAX_QUEUE=10
JWT_SECRET=
ADMIN_USER=
ADMIN_PASSWORD_HASH=
BARBER_USER=
BARBER_PASSWORD_HASH=
BARBER_PHONE=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173
ESCALATION_COOLDOWN_MS=900000
# HUMAN_TAKEOVER_TTL_MS=1800000
# PENDING_BOOKING_TTL_MS=600000
WEBHOOK_SECRET=
